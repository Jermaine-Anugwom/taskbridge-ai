TASKBRIDGE_DB=taskbridge.db
TASKBRIDGE_ENV=demo
TASKBRIDGE_MODEL_PROVIDER=deterministic
TASKBRIDGE_MODEL_TIMEOUT_SECONDS=20
TASKBRIDGE_MODEL_MAX_RETRIES=2
# Optional local Ollama:
# TASKBRIDGE_MODEL_PROVIDER=ollama
# TASKBRIDGE_MODEL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# TASKBRIDGE_MODEL_NAME=qwen2.5:7b
# Optional generic endpoint:
# TASKBRIDGE_MODEL_PROVIDER=generic
# TASKBRIDGE_MODEL_ENDPOINT=https://example.invalid/v1/chat/completions
# TASKBRIDGE_MODEL_NAME=configured-model
# TASKBRIDGE_MODEL_API_KEY=replace-locally
# TASKBRIDGE_MODEL_PROVIDER_NAME=approved-provider
# Optional published provider rates. Cost remains unknown when these are unset.
# TASKBRIDGE_INPUT_USD_PER_MILLION=0
# TASKBRIDGE_OUTPUT_USD_PER_MILLION=0

# Demo only. Production requires TASKBRIDGE_ENV=production and REQUIRE_AUTH=true.
# Production validates all three distinct token digests before connecting to PostgreSQL.
TASKBRIDGE_REQUIRE_AUTH=false
# TASKBRIDGE_VIEWER_TOKEN_SHA256=
# TASKBRIDGE_OPERATOR_TOKEN_SHA256=
# TASKBRIDGE_ADMIN_TOKEN_SHA256=
# TASKBRIDGE_POSTGRES_PASSWORD=generate-a-strong-url-safe-value-locally
